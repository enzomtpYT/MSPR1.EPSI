# ============================================
# MSPR1.EPSI - Environment Configuration
# ============================================

# ============================================
# DATABASE - PostgreSQL Configuration
# ============================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=etl_db

# ============================================
# RABBITMQ - Message Broker Configuration
# ============================================
RABBITMQ_DEFAULT_USER=rabbit
RABBITMQ_DEFAULT_PASS=rabbit_password

# ============================================
# DATABASE URL (for applications)
# ============================================
DATABASE_URL=postgresql://admin:password@database:5432/etl_db

# ============================================
# RABBITMQ URL (for applications)
# ============================================
RABBITMQ_URL=amqp://rabbit:rabbit_password@rabbitmq:5672/

# ============================================
# BACKEND - FastAPI Configuration
# ============================================
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=adminpassword123
DEFAULT_ADMIN_IS_ADMIN=true

# ============================================
# FRONTEND - Vue.js / Vite Configuration
# ============================================
VITE_API_URL=http://localhost:8000/api/v0
VITE_APP_NAME=HealthAI Coach

# ============================================
# AI MICROSERVICE - LLM Configuration
# ============================================
# Fournisseur LLM : "ollama" (local) ou "mistral" (cloud)
# - "ollama" : utilise un modèle local (par défaut, recommandé pour dev local)
# - "mistral" : utilise l'API Mistral Cloud pour les recommandations texte
LLM_PROVIDER=ollama

# Configuration Ollama (si LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Configuration Mistral Cloud API (si LLM_PROVIDER=mistral)
# Utilisé pour :
# - Génération de conseils nutritionnels et d'entraînement (LLM texte)
# - Analyse d'images de repas via Vision (pixtral-12b-2409)
MISTRAL_API_KEY=
MISTRAL_MODEL=pixtral-12b-2409

# ============================================
# MONITORING - Grafana Configuration
# ============================================
# Mot de passe administrateur Grafana (par defaut : admin)
GF_SECURITY_ADMIN_PASSWORD=admin

# ============================================
# OPTIONAL - Development Settings
# ============================================
# NODE_ENV=development
# COMPOSE_PROJECT_NAME=mspr1-epsi
