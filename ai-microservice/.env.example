# ──────────────────────────────────────────────────────────────────────────────
# HealthAI Coach – AI Microservice
# Copiez ce fichier en .env et renseignez vos valeurs
# ──────────────────────────────────────────────────────────────────────────────

# Base de données PostgreSQL (même DB que le backend FastAPI principal)
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/mspr_db

# Base de données MongoDB (stockage des recommandations)
MONGO_URL=mongodb://localhost:27017
MONGO_DB=healthai_recommendations

# Clé secrète JWT partagée avec le backend principal
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256

# Origines CORS autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Répertoire de sauvegarde des artefacts ML (relatif à la racine du microservice)
MODEL_DIR=artifacts

# Fournisseur LLM : "ollama" (local) ou "huggingface" (cloud)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Hugging Face (uniquement si LLM_PROVIDER=huggingface)
HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# Mistral Vision API
MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MISTRAL_MODEL=pixtral-12b-2409